[gd_resource type="SpriteFrames" load_steps=4 format=3]

[resource]
animations = [ "idle", "small_bounce", "ready", "attack_start", "hurt" ]

[ext_resource path="res://assets/attacker_0.png" type="Texture2D" id=1]
[ext_resource path="res://assets/attacker_1.png" type="Texture2D" id=2]
[ext_resource path="res://assets/defender_0.png" type="Texture2D" id=3]
[ext_resource path="res://assets/defender_1.png" type="Texture2D" id=4]

[resource.animation_idle]
frames = [ ExtResource(1), ExtResource(2) ]
speed = 4.0
loop = true

[resource.animation_small_bounce]
frames = [ ExtResource(1), ExtResource(2) ]
speed = 6.0
loop = true

[resource.animation_ready]
frames = [ ExtResource(2) ]
speed = 1.0
loop = false

[resource.animation_attack_start]
frames = [ ExtResource(2) ]
speed = 1.0
loop = false

[resource.animation_hurt]
frames = [ ExtResource(1) ]
speed = 1.0
loop = false
